{
  "name": "expo-router-app",
  "main": "App.tsx",
  "version": "0.1.0",
  "scripts": {
    "start": "expo start",
    "dev": "expo start --dev-client",
    "localization": "npx i18next-resources-for-ts interface -i ./src/i18n/en -o ./src/types/localization.d.ts",
    "android": "eas build -p android --profile development",
    "ios": "eas build -p ios --profile development",
    "build": "eas build --profile development --platform all",
    "app": "eas build --profile preview --platform all",
    "appios": "eas build --profile preview --platform ios",
    "appandroid": "eas build --profile preview --platform android",
    "web": "expo start --web",
    "test": "jest --watchAll"
  },
  "jest": {
    "preset": "jest-expo"
  },
  "dependencies": {
    "@expo/vector-icons": "^14.0.3",
    "@react-native-async-storage/async-storage": "1.23.0",
    "@react-native-community/masked-view": "^0.1.11",
    "@react-navigation/bottom-tabs": "^6.6.1",
    "@react-navigation/core": "^6.4.17",
    "@react-navigation/elements": "^1.3.31",
    "@react-navigation/native": "^6.1.18",
    "@react-navigation/native-stack": "^6.11.0",
    "@react-navigation/stack": "^6.4.1",
    "@realm/react": "^0.10.1",
    "dateformat": "^5.0.3",
    "expo": "~51.0.28",
    "expo-build-properties": "~0.12.5",
    "expo-dev-client": "~4.0.27",
    "expo-document-picker": "~12.0.2",
    "expo-file-system": "~17.0.1",
    "expo-font": "~12.0.10",
    "expo-image-manipulator": "~12.0.5",
    "expo-image-picker": "~15.0.7",
    "expo-linking": "~6.3.1",
    "expo-localization": "~15.0.3",
    "expo-router": "~3.5.23",
    "expo-sharing": "~12.0.1",
    "expo-splash-screen": "~0.27.6",
    "expo-status-bar": "~1.11.1",
    "expo-system-ui": "~3.0.7",
    "expo-web-browser": "~13.0.3",
    "i18n-js": "^4.4.3",
    "i18next": "^23.15.1",
    "immutability-helper": "^3.1.1",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "react-i18next": "^15.0.2",
    "react-native": "0.74.5",
    "react-native-chart-kit": "^6.12.0",
    "react-native-gesture-handler": "~2.16.1",
    "react-native-get-random-values": "~1.11.0",
    "react-native-keyboard-aware-scroll-view": "^0.9.5",
    "react-native-reanimated": "^3.10.1",
    "react-native-safe-area-context": "4.10.5",
    "react-native-screens": "^3.34.0",
    "react-native-shared-element": "^0.8.9",
    "react-native-svg": "15.2.0",
    "react-native-web": "~0.19.12",
    "react-navigation-shared-element": "^3.1.3",
    "realm": "^12.13.1"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@types/dateformat": "^5.0.2",
    "@types/react": "~18.2.79",
    "jest": "^29.7.0",
    "jest-expo": "~51.0.4",
    "react-test-renderer": "18.3.0",
